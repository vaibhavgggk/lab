prgm1
# Step 1: Create a fresh directory for Program 1 and enter it
mkdir program1-repo
cd program1-repo

# Step 2: Initialize a new Git repository
git init

# Step 3: Create a new file with some content
echo "This is my first exam file" > notes.txt

# Step 4: Add the file to the staging area
git add notes.txt

# Step 5: Commit the changes with a commit message
git commit -m "Initial commit: added notes.txt"

prgm2
# Step 1: Create a fresh directory, initialize, and make an initial commit on master
mkdir program2-repo
cd program2-repo
git init
echo "Base content" > main.txt
git add main.txt
git commit -m "Initial commit on master"

# Step 2: Create and switch to a new branch named 'feature-branch'
git checkout -b feature-branch

# Step 3: Make a change inside the feature branch and commit it
echo "Feature work added" >> main.txt
git add main.txt
git commit -m "Added feature updates"

# Step 4: Switch back to the master branch
git checkout master

# Step 5: Merge 'feature-branch' into 'master'
git merge feature-branch

prgm3
# Step 1: Create a fresh directory, initialize, and create a tracked baseline file
mkdir program3-repo
cd program3-repo
git init
echo "Baseline data" > data.txt
git add data.txt
git commit -m "Baseline commit"

# Step 2: Make uncommitted modifications to be stashed
echo "Unfinished work to stash" >> data.txt

# Step 3: Stash your current changes
git stash save "Stashing incomplete data changes"

# Step 4: Switch to a new branch (or another branch)
git checkout -b temp-branch

# Step 5: Switch back to your original branch (master)
git checkout master

# Step 6: Apply and remove the stashed changes back to your working directory
git stash pop

prgm4
# Step 1: Clone the remote repository directly to your local machine
git clone https://github.com/octocat/Spoon-Knife.git

# Step 2: Navigate into the newly cloned directory
cd Spoon-Knife

prgm5
# Step 1: Clone a remote repository to set up a local working copy with a remote origin
git clone https://github.com/octocat/Spoon-Knife.git
cd Spoon-Knife

# Step 2: Fetch the latest changes and updates from the remote repository
git fetch origin

# Step 3: Rebase your current local branch onto the updated remote branch (using main or master depending on the repo)
git rebase origin/main

prgm6
# Step 1: Create a fresh directory, initialize, and create a base commit on master
mkdir program6-repo
cd program6-repo
git init
echo "Starting code" > app.py
git add app.py
git commit -m "Initial commit on master"

# Step 2: Create and switch to 'feature-branch'
git checkout -b feature-branch

# Step 3: Make modifications on the feature branch and commit
echo "print('Hello Feature')" >> app.py
git add app.py
git commit -m "Added feature code"

# Step 4: Switch back to the master branch
git checkout master

# Step 5: Merge 'feature-branch' into 'master' with a custom merge commit message
git merge --no-ff feature-branch -m "Custom Merge Message: Successfully integrated feature-branch into master for lab evaluation"
